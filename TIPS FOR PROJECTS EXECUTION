Flask route example
@app.route('/upload', methods=['POST'])
def upload():
    file = request.files['file']
    # 1. Generate key from graphical hash
    key = SHA256(user.graphical_hash + user.salt).digest()[:32]
    # 2. Encrypt file
    cipher = AES.new(key, AES.MODE_CBC)
    encrypted = cipher.encrypt(pad(file.read(), AES.block_size))
    # 3. Upload to S3
    s3.upload_fileobj(encrypted, S3_BUCKET, file.filename + ".enc")
    # 4. Save to DB
    save_to_db(file.filename, cloud_path)
    return "Upload Success - Encrypted & Stored"
